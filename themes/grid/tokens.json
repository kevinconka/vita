{
  "$comment": "Graph Paper / Brutalist — the page shows its own construction. A 5mm graph ground drawn in CSS, content snapped into hard-bordered cells, monospace everywhere, zero radius. Ink and one signal orange.",

  "color": {
    "background": "#f7f6f2",
    "graph": "#dfe3e0",
    "graph-major": "#cdd3cf",
    "ink": "#111111",
    "muted": "#5c5c5c",
    "accent": "#ff4d00",
    "cell": "#ffffff"
  },

  "font": {
    "body": "'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace",
    "display": "'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace",
    "size-base": "8.5pt",
    "line-height": "1.45",
    "name-size": "26pt",
    "name-weight": "700",
    "label-size": "7pt",
    "label-tracking": "0.14em"
  },

  "space": {
    "unit": "0.25rem",
    "cell-pad": "3.5mm",
    "gap": "0px"
  },

  "page": { "size": "A4", "margin": "10mm" },

  "graph": {
    "minor": "5mm",
    "major": "25mm"
  },

  "border": {
    "width": "1.5px",
    "heavy": "3px"
  }
}
