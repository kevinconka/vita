{
  "$comment": "Monochrome Noir — inverted. Near-black stock, warm off-white ink, one acid accent used only for structure (labels, employer, rules). Section titles live in the left margin rather than above the content.",

  "color": {
    "background": "#0b0b0d",
    "surface": "#141417",
    "text": "#ececee",
    "muted": "#7a7a82",
    "accent": "#c8ff2f",
    "rule": "#26262b",
    "link": "#c8ff2f"
  },

  "font": {
    "display": "'Archivo', 'Helvetica Neue', Helvetica, Arial, sans-serif",
    "body": "'Inter', 'Helvetica Neue', Helvetica, Arial, sans-serif",
    "label": "'JetBrains Mono', ui-monospace, Menlo, monospace",
    "size-base": "9.5pt",
    "line-height": "1.55",
    "name-size": "34pt",
    "name-weight": "800",
    "name-tracking": "-0.03em",
    "label-size": "7.5pt",
    "label-tracking": "0.18em"
  },

  "space": {
    "unit": "0.25rem",
    "section": "1.5rem",
    "entry": "0.95rem",
    "bullet": "0.34rem",
    "gutter": "26mm"
  },

  "page": {
    "size": "A4",
    "margin": "14mm"
  },

  "rule": {
    "width": "1px",
    "accent-width": "2px"
  }
}
