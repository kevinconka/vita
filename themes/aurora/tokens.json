  "radius": {
    "sm": "6px",
    "md": "8px",
    "lg": "12px"
  },
  "page": {
    "size": "A4",
    "margin": "0",
    "inset": "12mm"
  },
  "bloom": {
    "size": "150mm",
    "opacity": "0.5"
  },
  "hairline": {
    "width": "1px"
  }
