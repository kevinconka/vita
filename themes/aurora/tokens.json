{
  "$comment": "aurora \u2014 Linear's actual system, applied to paper. Surface ladder + hairlines instead of shadows, one chromatic accent, Inter at display sizes with aggressive negative tracking. Values taken from Linear's published DESIGN.md rather than eyeballed.",
  "color": {
    "canvas": "#010102",
    "surface-1": "#0f1011",
    "surface-2": "#141516",
    "hairline": "#23252a",
    "hairline-strong": "#34343a",
    "ink": "#f7f8f8",
    "ink-muted": "#d0d6e0",
    "ink-subtle": "#8a8f98",
    "ink-tertiary": "#62666d",
    "accent": "#5e6ad2",
    "accent-bright": "#7170ff"
  },
  "font": {
    "sans": "'Inter', 'SF Pro Display', -apple-system, 'Helvetica Neue', Arial, sans-serif",
    "mono": "'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace",
    "size-base": "8pt",
    "display-size": "31pt",
    "display-weight": "600",
    "display-tracking": "-0.032em",
    "headline-size": "13pt",
    "headline-weight": "600",
    "headline-tracking": "-0.014em",
    "eyebrow-size": "7pt",
