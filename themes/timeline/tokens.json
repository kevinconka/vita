{
  "$comment": "Asymmetric Timeline \u2014 a single rail runs the height of the page. Every role and degree is a marker on it, so the CV reads as one continuous track rather than as separate boxed sections. Serif body against a grotesk masthead.",
  "color": {
    "background": "#fbfaf7",
    "text": "#1a1d29",
    "muted": "#6b7280",
    "accent": "#e2574c",
    "rail": "#dcd8cf",
    "rule": "#e8e4dc"
  },
  "font": {
    "display": "'Archivo', 'Helvetica Neue', Helvetica, Arial, sans-serif",
    "body": "'Source Serif 4', Georgia, 'Times New Roman', serif",
    "label": "'Archivo', 'Helvetica Neue', Helvetica, Arial, sans-serif",
    "size-base": "9.5pt",
    "line-height": "1.5",
    "name-size": "32pt",
    "name-weight": "800",
    "name-tracking": "-0.04em",
    "label-size": "7.5pt",
    "label-tracking": "0.16em"
  },
  "space": {
    "unit": "0.25rem",
    "section": "1.15rem",
    "entry": "0.9rem",
    "bullet": "0.3rem",
    "rail-offset": "30mm"
  },
  "page": {
    "size": "A4",
    "margin": "12mm"
  },
  "marker": {
    "size": "9px",
    "ring": "3px"
  },
  "rule": {
    "width": "1px",
    "rail-width": "2px"
  }
}
