{
  "$comment": "Brand tokens. Every value here becomes a CSS custom property (color.accent -> --color-accent) that style.css reads. Nothing in style.css or template.hbs hardcodes a brand value, so this file is the whole visual identity. Starter values are deliberately neutral \u2014 see 'Make it yours' in the README.",
  "color": {
    "background": "#ffffff",
    "surface": "#f4f4f5",
    "text": "#18181b",
    "muted": "#71717a",
    "accent": "#3f3f46",
    "accent-contrast": "#ffffff",
    "rule": "#e4e4e7",
    "link": "#3f3f46"
  },
  "font": {
    "body": "'Source Sans 3', 'Helvetica Neue', Helvetica, Arial, sans-serif",
    "heading": "'Source Sans 3', 'Helvetica Neue', Helvetica, Arial, sans-serif",
    "mono": "'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace",
    "size-base": "10pt",
    "scale-ratio": "1.2",
    "line-height": "1.45",
    "weight-body": "400",
    "weight-heading": "600",
    "heading-transform": "uppercase",
    "heading-tracking": "0.08em"
  },
  "space": {
    "unit": "0.25rem",
    "section": "1.5rem",
    "entry": "0.85rem",
    "bullet": "0.3rem",
    "column-gap": "1.6rem"
  },
  "page": {
    "size": "A4",
    "margin": "13mm",
    "columns": "0.66fr 0.34fr"
  },
  "rule": {
    "width": "2px",
    "section-gap": "0.35rem"
  },
  "tag": {
    "background": "#f4f4f5",
    "color": "#3f3f46",
    "radius": "3px",
    "padding": "0.12em 0.5em"
  },
  "avatar": {
    "size": "22mm",
    "radius": "50%",
    "border-width": "0"
  }
}
