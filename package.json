{
  "name": "vita",
  "version": "0.1.0",
  "description": "CV as code: write tagged bullets once, compose a job-tailored resume, render branded HTML and PDF.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "vita": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20.14.0"
  },
  "packageManager": "pnpm@10.33.0",
  "files": [
    "dist",
    "theme"
  ],
  "scripts": {
    "vita": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "knip": "knip",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "handlebars": "^4.7.9",
    "marked": "^18.0.7",
    "playwright": "^1.62.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "knip": "^6.31.0",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "tsx": "^4.23.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook"
    ]
  }
}
